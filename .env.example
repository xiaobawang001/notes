# ── Coze API ──
COZE_TOKEN=your_coze_personal_access_token
COZE_BASE_URL=https://api.coze.cn
COZE_USERS_DATABASE_ID=your_users_database_id
COZE_NOTES_DATABASE_ID=your_notes_database_id

# ── PostgreSQL ──
PG_HOST=your-pg-host.example.com
PG_PORT=5432
PG_DATABASE=your_database_name
PG_USER=your_pg_user
PG_PASSWORD=your_pg_password
PG_SSL=false

# ── JWT ──
SECRET_KEY=your-random-secret-key-at-least-32-chars

# ── 前端 ──
# VITE_API_PREFIX=/postgre/v1  （默认值，可不设置）
