{
  "rewrites": [
    {
      "source": "/coze/v1/:path*",
      "destination": "http://backend:8000/coze/v1/:path*"
    },
    {
      "source": "/postgre/v1/:path*",
      "destination": "http://backend:8000/postgre/v1/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/:path*"
    }
  ]
}
